set(OpenCV_DIR "/home/arclab/opensource/opencv-3.4.1")
set(TBB_ROOT_DIR "/home/arclab/opensource/tbb2018_20171205oss")
set(TBB_INCLUDE_DIRS "/home/arclab/opensource/tbb2018_20171205oss/include")
set(TBB_LIBRARIES "/home/arclab/opensource/tbb2018_20171205oss/lib/intel64/gcc4.4/libtbb_debug.so")
