#PkgConfig
find_package(PkgConfig REQUIRED)
pkg_search_module(GLFW REQUIRED glfw3)
include_directories(${GLFW_INCLUDE_DIRS})

# opengl
find_package(OpenGL REQUIRED)
include_directories(${OPENGL_INCLUDE_DIRS})

find_package(glm REQUIRED)
include_directories(${glm_INCLUDE_DIR})

find_package(VTK REQUIRED)
message(STATUS "VTK_VERSION: ${VTK_VERSION}")
include(${VTK_USE_FILE})

# Find OpenCV
find_package( OpenCV REQUIRED )
message(STATUS "${OpenCV_VERSION}")
message(STATUS "${OpenCV_INCLUDE_DIRS}")
include_directories(${OpenCV_INCLUDE_DIRS})

find_package(catkin REQUIRED COMPONENTS
  cv_bridge
  image_transport
  sensor_msgs
)
catkin_package(
  INCLUDE_DIRS include
  LIBRARIES dvrk-OpenGLViewer
  CATKIN_DEPENDS cv_bridge image_transport message_runtime sensor_msgs
  DEPENDS PkgConfig OpenGL glm VTK OpenCV
)
include_directories(
  ${catkin_INCLUDE_DIRS}
)

#DO NOT BUILD UNTIL RESOLVED ISSUE WITH BUILDING THE SAME THING IN EKF_OpenGL
if (USE_IMGUI)
    # IMGUI
    set(IMGUI_DIR "imgui-glew/")
    set(IMGUI_SOURCES
            ${IMGUI_DIR}/imgui.cpp
            ${IMGUI_DIR}/imgui_demo.cpp
            ${IMGUI_DIR}/imgui_draw.cpp
            ${IMGUI_DIR}/imgui_impl_glfw_gl3.cpp)
    set(IMGUI_HEADERS
            ${IMGUI_DIR}/imconfig.h
            ${IMGUI_DIR}/imgui.h
            ${IMGUI_DIR}/imgui_internal.h
            ${IMGUI_DIR}/stb_rect_pack.h
            ${IMGUI_DIR}/stb_textedit.h
            ${IMGUI_DIR}/stb_truetype.h
            ${IMGUI_DIR}/imgui_impl_glfw_gl3.h)
    add_definitions(-D__WITH_IMGUI)


    include_directories(${IMGUI_DIR})
    add_library(ImGui ${IMGUI_SOURCES} ${IMGUI_HEADERS})
    set(IMGUI_IMPL ${IMGUI_DIR}/imgui_impl_glfw_gl3.h ${IMGUI_DIR}/imgui_impl_glfw_gl3.cpp
            vtkExternalOpenGLRenderWindowFixed.cpp vtkExternalOpenGLRenderWindowFixed.h)
endif()

set (SOURCE_FILES
        src/get_cwd.cpp
        src/GLError.cpp
        src/ImageProvider.cpp
        src/shader.cpp
        src/SimpleTimer.cpp
        src/StereoWindow.cpp
        src/TextureRenderer.cpp
        src/VTKCameraManager.cpp
        src/vtkExternalOpenGLRenderWindowFixed.cpp
        src/VTKRenderProcedure.cpp
        src/StaticStereoImageSource.cpp
        src/ROSStereoImageProvider.cpp
        src/CameraTextureRenderer.cpp
        )

set(HEADER_FILES
        include/dvrk_OpenGLViewer/get_cwd.h
        include/dvrk_OpenGLViewer/GLError.h
        include/dvrk_OpenGLViewer/IImageAligned.h
        include/dvrk_OpenGLViewer/ImageProvider.h
        include/dvrk_OpenGLViewer/IRenderProcedure.h
        include/dvrk_OpenGLViewer/shader.h
        include/dvrk_OpenGLViewer/SimpleTimer.h
        include/dvrk_OpenGLViewer/StaticStereoImageSource.h
        include/dvrk_OpenGLViewer/StereoWindow.h
        include/dvrk_OpenGLViewer/TextureRenderer.h
        include/dvrk_OpenGLViewer/VTKCameraManager.h
        include/dvrk_OpenGLViewer/vtkExternalOpenGLRenderWindowFixed.h
        include/dvrk_OpenGLViewer/VTKRenderProcedure.h
        include/dvrk_OpenGLViewer/ROSStereoImageProvider.h
        include/dvrk_OpenGLViewer/CameraTextureRenderer.h
        )

include_directories (${PROJECT_SOURCE_DIR}/include)


add_library(${PROJECT_NAME}
            ${SOURCE_FILES}
            ${HEADER_FILES})

target_link_libraries(
        ${PROJECT_NAME}
        pthread
        ${TBB_LIBRARIES}
        ${GLFW_LIBRARIES}
        ${VTK_LIBRARIES}
        ${OPENGL_LIBRARIES}
        ${GLEW_LIBRARIES}
        ${OpenCV_LIBS}
        ${catkin_LIBRARIES}
    )

if (USE_IMGUI)
    target_link_libraries(
        ${PROJECT_NAME}
        ImGui
        )
endif()


add_executable(sample_cube  examples/cube_sample.cpp
                            examples/CubeCameraTextureRenderer.cpp
                            examples/CubeAxesVTKRenderProcedure.cpp
                            examples/CubeAxesVTKRenderProcedure.h
                            examples/CubeCameraTextureRenderer.h)

target_link_libraries(sample_cube ${PROJECT_NAME} ${OPENGL_LIBRARIES})


add_executable(viewer_only  examples/viewer_only.cpp)

target_link_libraries(viewer_only ${PROJECT_NAME} ${OPENGL_LIBRARIES})


file(GLOB FRAG_SHADERS "src/*.frag")
file(GLOB VERT_SHADERS "src/*.vert")
