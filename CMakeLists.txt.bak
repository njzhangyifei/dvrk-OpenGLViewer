cmake_minimum_required(VERSION 3.5)
project(dvrk_OpenGLViewer)

#list(APPEND CMAKE_MODULE_PATH ${PROJECT_SOURCE_DIR}/cmake/modules/FindTBB)

set(CMAKE_CXX_STANDARD 14)

set(USE_IMGUI FALSE) #Set to false, otherwise we buid 2 img gui in this workspace. PLEASE FIX
                     #Second imgui is built in EKF_OpenGL

#Always set to true with this build...
set(WITH_ROS TRUE)
set(ARCLAB TRUE)
add_definitions(-D__ARCLAB)
add_definitions(-D__WITH_ROS)


# set(VTK_DIR "~/develop/opensource/VTK-build/")
